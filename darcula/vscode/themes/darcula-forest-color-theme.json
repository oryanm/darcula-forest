  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#808080",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.block.javadoc"
      ],
      "settings": {
        "foreground": "#6d8c40",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment tag",
      "scope": [
        "comment.block.documentation keyword",
        "comment.block.documentation storage.type.class",
        "comment.block.documentation entity.name.type.instance"
      ],
      "settings": {
        "foreground": "#6d8c40",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment markup",
      "scope": [
        "comment.block.documentation markup",
        "comment.block.documentation variable"
      ],
      "settings": {
        "foreground": "#8aab5f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.other",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#5f7d31"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#acafa9"
      }
    },
    {
      "name": "Word operator",
      "scope": [
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.operator.wordlike"
      ],
      "settings": {
        "foreground": "#5f7d31"
      }
    },
    {
      "name": "Language constant",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#5f7d31"
      }
    },
    {
      "name": "Implicit receiver",
      "scope": [
        "variable.language.this",
        "variable.language.self",
        "variable.language.it",
        "variable.parameter.function.language.special.self"
      ],
      "settings": {
        "foreground": "#83af3e",
        "fontStyle": "italic"
      }
    },
